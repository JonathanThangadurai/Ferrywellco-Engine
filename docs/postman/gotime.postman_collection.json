        {
          "name": "Normal: Amsterdam",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"sandbox mode is flagged\", () => pm.expect(b.mode).to.eql(\"sandbox\"));",
                  "pm.test(\"attribution present\", () => pm.expect(b.data.attribution.length).to.be.above(0));",
                  "pm.test(\"Amsterdam\", () => pm.expect(b.location.alias).to.eql(\"amsterdam\"));",
                  "pm.test(\"window found\", () => pm.expect(b.window.status).to.eql(\"found\"));",
                  "pm.test(\"data ok (fixed test clock only)\", () => { if (pm.environment.get(\"expectFresh\") === \"true\") pm.expect(b.data.status).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/v1/guidance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": {\n    \"lat\": 52.37,\n    \"lon\": 4.9\n  },\n  \"date\": \"{{date}}\",\n  \"earliest_start\": \"07:00\",\n  \"latest_start\": \"19:00\",\n  \"activity_type\": \"run\",\n  \"duration_min\": 45,\n  \"hay_fever\": \"yes\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
