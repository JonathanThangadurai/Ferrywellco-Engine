{
  "info": {
    "_postman_id": "5f8e2b8e-6a1d-4f7e-9c1b-2d7f3c4a9b10",
    "name": "GOTime API 0.1.0 (sandbox)",
    "description": "GOTime API sandbox requests (docs/partner-guide.md). Responses in the sandbox are synthetic examples, not guidance. The folder 'Test environment only' needs the CI test setup (fixed clocks, a revoked key).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// date: use the environment value, or tomorrow (UTC), which is a valid local date in every covered city.",
          "if (!pm.environment.get('date')) {",
          "  const d = new Date(Date.now() + 24 * 3600 * 1000);",
          "  pm.variables.set('date', d.toISOString().slice(0, 10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Sandbox",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
