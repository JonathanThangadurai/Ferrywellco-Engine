# Copy to /etc/gotime/gotime.env on the server (chmod 600, owned by root). Never commit the real file.
# Names only here; fill in the values on the server.

# Data sources
KNMI_API_KEY=
KNMI_EDR_API_KEY=
COPERNICUS_KEY=
ADS_URL=https://ads.atmosphere.copernicus.eu/api
CDS_URL=https://cds.climate.copernicus.eu/api
OPENAQ_API_KEY=

# Heartbeats (e.g. healthchecks.io ping URLs). Unset = skipped with a warning.
HC_PING_INGEST=
HC_PING_PRECOMPUTE=
HC_PING_MONITOR=

# Synthetic monitor: a dedicated sandbox key (gotime-api keys create --partner monitor --mode sandbox)
GOTIME_MONITOR_KEY=

# Caddy
GOTIME_DOMAIN=api.example.com
ACME_EMAIL=
